+    def test_runtime_oom_halves_without_duplicate_tiles_or_cpu(self):
+        class Limited(torch.nn.Module):
+            def __init__(self):
+                super().__init__(); self.weight = torch.nn.Parameter(torch.ones(1, device="cuda")); self.calls = []
+            def forward(self, x):
