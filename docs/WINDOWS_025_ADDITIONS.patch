+        from qtpy.QtWidgets import QApplication
+        from napari.components import ViewerModel
+        from napari_label_workflow.widget import WorkflowWidget
+        from napari_label_workflow.project import create_project
+        from napari_label_workflow import nninteractive_client
+        from test_nninteractive import FakeClient
+        import tifffile
+        app = QApplication.instance() or QApplication([])
+        with tempfile.TemporaryDirectory(ignore_cleanup_errors=True) as folder:
+            root = Path(folder)
+            data = np.random.default_rng(19).integers(0, 999, (2, 10, 48, 48), dtype=np.uint16)
+            source = root / 'named.ome.tif'
+            tifffile.imwrite(source, data, ome=True, metadata={'axes': 'CZYX', 'Channel': {'Name': ['Cy5', 'DAPI']}})
+            project = create_project(root / 'p', ['Channel 0', 'Channel 1'], ['Background', 'Nucleus'], task='objects')
+            project.add_crop(data, {'path': str(source), 'channel_names': [], 'spacing_zyx': [.26, .1, .1]}, 'TX_TEST')
+            viewer = ViewerModel(); w = WorkflowWidget(viewer); w.timer.stop()
+            w.task = lambda work, callback: callback(work())
+            w._failed = lambda text: (_ for _ in ()).throw(AssertionError(text))
+            fake = FakeClient((10, 48, 48))
+            try:
+                w.open_project(project.root); w.continue_round(1)
+                self.assertEqual(w.project.config['channels'], ['Channel 0', 'Channel 1'])
+                self.assertEqual([x.name for x in w.channel_layers], ['Cy5', 'DAPI'])
+                w.channel_checks[0].setChecked(True); w.channel_checks[1].setChecked(False)
+                w.channel_layers[0].visible = False
+                with patch.object(nninteractive_client, 'available', return_value=(True, '')), patch.object(nninteractive_client, 'NNInteractive', return_value=fake):
+                    w.nni.start_button.setChecked(True)
+                self.assertEqual(fake.image_key, (w.record['id'], (0,)))
+                w.nni.points.add([5, 22, 22]); app.processEvents()
+                self.assertTrue(w.nni.has_preview())
+                before = w.nni.preview.data.copy()
+                w.channel_checks[0].setChecked(False); w.channel_checks[1].setChecked(True)
+                w.nni._sync_channel()
+                self.assertEqual(fake.image_key, (w.record['id'], (0,)))
+                np.testing.assert_array_equal(w.nni.preview.data, before)
+                w.nni.clear(); w.nni.points.add([5, 22, 22]); app.processEvents()
+                self.assertEqual(fake.image_key, (w.record['id'], (1,)))
+                w.nni.clear(); w.channel_checks[1].setChecked(False)
+                w.nni.points.add([5, 22, 22]); app.processEvents()
+                self.assertEqual(fake.image_key, (w.record['id'], (0, 1)))
+                self.assertEqual(w.project.config['channels'], ['Channel 0', 'Channel 1'])
+            finally:
+                w.nni.shutdown(); w.writer.shutdown(wait=True); w.pool.shutdown(wait=True); w.close(); viewer.layers.clear()
+
+
+if __name__ == '__main__':
+    unittest.main()
