+"""Cross-platform updater contracts using real queued Qt signals; no downloads or installs."""
+import os
+import sys
+import tempfile
+import time
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+
+
+class PortableVersionAndPaths(unittest.TestCase):
+    def test_running_source_version_wins_over_stale_wheel_metadata(self):
+        from napari_label_workflow import updater, __version__
+        with patch('importlib.metadata.version', return_value='0.1.20') as installed:
+            self.assertEqual(updater.current_version(), __version__)
+            installed.assert_not_called()
+
+    def test_platform_paths_preserve_mac_and_use_windows_localappdata(self):
+        from napari_label_workflow import updater
+        with tempfile.TemporaryDirectory() as folder:
+            home = Path(folder); local = home / 'Windows data'; xdg = home / 'Linux config'
+            with patch.object(Path, 'home', return_value=home), patch.dict(os.environ, {'LOCALAPPDATA': str(local), 'XDG_CONFIG_HOME': str(xdg)}):
+                with patch.object(sys, 'platform', 'win32'):
+                    self.assertEqual(updater.support_directory(), local / 'LabelWorkflow')
+                    with patch.dict(os.environ, {'LOCALAPPDATA': ''}):
+                        self.assertEqual(updater.support_directory(), home / 'AppData' / 'Local' / 'LabelWorkflow')
+                with patch.object(sys, 'platform', 'darwin'):
+                    self.assertEqual(updater.support_directory(), home / 'Library' / 'Application Support' / 'LabelWorkflow')
+                with patch.object(sys, 'platform', 'linux'):
+                    self.assertEqual(updater.support_directory(), xdg / 'LabelWorkflow')
+            self.assertEqual(list(home.iterdir()), [])  # resolving a path never creates an environment/settings tree
+
+
+class QueuedUpdateAnnouncement(unittest.TestCase):
+    def test_startup_mode_survives_worker_signal_and_respects_busy(self):
+        from qtpy.QtWidgets import QApplication, QWidget, QHBoxLayout
+        from napari_label_workflow import updater
+        from napari_label_workflow.update_panel import UpdateControls
+        app = QApplication.instance() or QApplication([])
+        wf = QWidget(); wf.header_row = QHBoxLayout(wf); wf.viewer = SimpleNamespace()
+        wf.busy = False; wf.guard = lambda action: action(); messages = []; wf._status = messages.append
+        controls = UpdateControls(wf)
+        result = updater.UpdateCheck(True, '0.2.5', '0.2.6', {'version': '0.2.6', 'notes': '- Faster preview', 'page': 'https://example.invalid/release'}, 'new release')
+        received = []; controls.relay.checked.connect(lambda value, mode: received.append((value, mode)))
+        popups = []
+
+        def wait_for_signal(before):
+            deadline = time.monotonic() + 5
+            while len(received) == before and time.monotonic() < deadline:
+                app.processEvents(); time.sleep(.001)
+            self.assertEqual(len(received), before + 1)
+            app.processEvents()
+
+        try:
+            with patch.object(sys, 'platform', 'win32'), patch.object(updater, 'check', return_value=result), \
+                 patch.object(updater, 'save_settings') as save, \
+                 patch.object(controls, '_popup', side_effect=lambda value, text, action: (popups.append((text, action)), 'no')[1]):
+                wf.busy = True; controls.check(quiet=True, announce=True); wait_for_signal(0)
+                self.assertEqual(received[-1][1], 'announce'); self.assertEqual(popups, [])
+                wf.busy = False; controls.check(quiet=True, announce=True); wait_for_signal(1)
+                self.assertEqual(received[-1][1], 'announce'); self.assertEqual(len(popups), 1)
+                self.assertEqual(popups[0][1], 'Open download page'); self.assertIn('Faster preview', popups[0][0])
+                controls.check(quiet=True); wait_for_signal(2)
+                self.assertIs(received[-1][1], True); self.assertEqual(len(popups), 1)
+                controls.check(quiet=False); wait_for_signal(3)
+                self.assertIs(received[-1][1], False); self.assertEqual(len(popups), 2)
+                self.assertEqual(save.call_count, 4)
+            with patch.object(sys, 'platform', 'win32'), patch.object(controls, '_popup', return_value='yes'), \
+                 patch('webbrowser.open') as browser, patch.object(updater, 'prepare') as install:
+                controls.offer(); browser.assert_called_once_with('https://example.invalid/release'); install.assert_not_called()
+        finally:
+            controls.relay.checked.disconnect(); wf.close(); wf.deleteLater(); app.processEvents()
+
+
+if __name__ == '__main__':
+    unittest.main()
