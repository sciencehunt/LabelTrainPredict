+class CapacityMetadata(unittest.TestCase):
+    def test_device_names_are_canonical_without_framework(self):
+        self.assertEqual(capacity.canonical_device_name("mps"), "mps:0")
+        self.assertEqual(capacity.canonical_device_name("mps:0"), "mps:0")
+        self.assertEqual(capacity.canonical_device_name("cuda", 2), "cuda:2")
+        self.assertEqual(capacity.canonical_device_name("cuda:1", 2), "cuda:1")
+        self.assertEqual(capacity.canonical_device_name("cpu"), "cpu")
+
+    def test_device_defaults_and_explicit_precedence(self):
+        self.assertEqual(capacity.batch_settings("3d", "cuda", environ={})["max_batch_size"], 8)
+        self.assertEqual(capacity.batch_settings("2.5d", "cuda", environ={})["max_batch_size"], 32)
+        self.assertEqual(capacity.batch_settings("2.5d", "mps", environ={}),
+                         {"max_batch_size": 8, "autotune": False, "cap_source": "device_local_default"})
+        self.assertEqual(capacity.batch_settings("3d", "cpu", 32, environ={})["max_batch_size"], 1)
+        selected = capacity.batch_settings("3d", "cuda", 4, environ={"LABEL_WORKFLOW_PREDICT_BATCH": "1"})
+        self.assertEqual(selected["max_batch_size"], 4)
+        self.assertTrue(selected["autotune"])
+
+    def test_legacy_fixed_cap_and_new_maximum(self):
+        fixed = capacity.batch_settings("3d", "cuda", environ={"LABEL_WORKFLOW_PREDICT_BATCH": "3"})
+        self.assertFalse(fixed["autotune"])
+        self.assertEqual(fixed["max_batch_size"], 3)
+        maximum = capacity.batch_settings("3d", "cuda", environ={"LABEL_WORKFLOW_PREDICT_MAX_BATCH": "16"})
+        self.assertTrue(maximum["autotune"])
+        self.assertEqual(maximum["max_batch_size"], 16)
+
+    def test_invalid_caps_fail_instead_of_allocating(self):
+        for cap in (0, -1, 129, True, 1.5, "1.0", "x"):
+            with self.subTest(cap=cap), self.assertRaises(ValueError):
+                capacity.batch_settings("3d", "cuda", cap, environ={})
+
+    def test_bounded_candidates(self):
+        self.assertEqual(capacity.candidate_batches(7), [1, 2, 4, 7])
+        self.assertEqual(capacity.candidate_batches(1), [1])
+        self.assertEqual(capacity.candidate_batches(32), [1, 2, 4, 8, 16, 32])
+
+    def test_measured_selection_retains_small_batch_without_improvement(self):
+        trials = [{"state": "measured", "batch_size": 1, "seconds": .1},
+                  {"state": "measured", "batch_size": 2, "seconds": .199},
+                  {"state": "measured", "batch_size": 4, "seconds": .2},
+                  {"state": "cuda_oom", "batch_size": 8}]
+        self.assertEqual(capacity.choose_batch(trials), 4)
+        self.assertEqual(capacity.choose_batch(trials[:2]), 1)
+
+    def test_no_cpu_model_fallback_in_tiled_paths(self):
+        tree = ast.parse((ROOT / "src/napari_label_workflow/training.py").read_text(encoding="utf-8"))
+        names = {"_predict_tiled", "_predict_tiled_cuda", "predict_loaded"}
+        functions = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name in names]
+        self.assertEqual(len(functions), 3)
