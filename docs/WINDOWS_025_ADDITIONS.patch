+"""Versioned full-image GPU inference on a configured SSH workstation.
+
+The local app only prepares/copies files and receives outputs. Model loading,
+capacity selection and inference happen on the workstation. Cancellation writes
+an authenticated job-local sentinel; it never kills a process by name or PID.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath, PureWindowsPath
+import queue
+import re
+import shutil
+import subprocess
+import threading
+import time
+from urllib.parse import unquote, urlsplit
+import uuid
+
+
+PROTOCOL = "ltp-remote-full-image-v1"
+
+
+def _device_request(value):
+    value = str(value or "auto").strip().lower()
+    if value not in ("auto", "cuda", "mps") and not re.fullmatch(r"cuda:\d+", value):
+        raise ValueError("Remote inference requires a GPU; choose auto, CUDA or Apple MPS, not CPU.")
+    return value
+
+
+def _sha(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _write(path, value):
+    path = Path(path); temporary = path.with_suffix(path.suffix + ".part")
+    temporary.write_text(json.dumps(value, indent=2), encoding="utf-8")
+    temporary.replace(path)
+
+
+def _checked_relative(text):
+    if not isinstance(text, str):
+        raise ValueError("Unsafe path in the remote inference manifest.")
+    path = PurePosixPath(text)
+    if ("\\" in text or path.is_absolute() or PureWindowsPath(text).drive or not path.parts
+            or any(x in ("", ".", "..") or ":" in x for x in path.parts)):
+        raise ValueError("Unsafe path in the remote inference manifest.")
+    return path
+
+
+def _source_parts(source, workstation, source_is_remote):
+    """Keep the selected series; SSH paths must name this exact workstation."""
+    text = str(source)
+    if text.startswith("ssh://"):
+        parsed = urlsplit(text)
+        if parsed.netloc != workstation.target or parsed.query or parsed.fragment:
+            raise ValueError("The image SSH address must match the selected workstation exactly.")
+        text = unquote(parsed.path); source_is_remote = True
+    path, series = text.rsplit("::", 1) if "::" in text else (text, None)
+    if not path or any(c in path for c in ("\x00", "\r", "\n")):
+        raise ValueError("Invalid image path.")
+    if source_is_remote and not (PurePosixPath(path).is_absolute() or PureWindowsPath(path).is_absolute()):
+        raise ValueError("Use an absolute image path on the workstation.")
+    if series is not None and (not series or any(c in series for c in ("/", "\\", "\x00", "\n", "\r"))):
+        raise ValueError("Invalid image-series selector.")
+    return path, series, bool(source_is_remote)
+
+
+def _image_files(path):
+    path = Path(path)
+    if not path.is_file():
+        raise ValueError(f"Image file does not exist: {path}")
+    files = [path]
+    if path.suffix.lower() == ".oif":
+        companion = Path(str(path) + ".files")
+        if not companion.is_dir():
+            raise ValueError("An OIF image requires its adjacent .oif.files folder.")
+        files += sorted(p for p in companion.rglob("*") if p.is_file())
+    return files
+
+
+def prepare_package(ws, checkpoint, source, output_root, *, source_is_remote=False, **options):
+    """Snapshot files only. This function never imports PyTorch or executes a model."""
+    from .remote import ENGINE_MODULES
+    requested_device = _device_request(ws.device)
+    checkpoint = Path(checkpoint).resolve()
+    if not checkpoint.is_file():
+        raise ValueError("Choose an existing model checkpoint.")
+    source_path, series, remote_source = _source_parts(source, ws, source_is_remote)
+    job_id = uuid.uuid4().hex
+    package = Path(output_root).resolve()/".remote_jobs"/("inference_" + job_id)
+    package.mkdir(parents=True, exist_ok=False)
+    engine = package/"label_workflow_engine"; engine.mkdir()
+    here = Path(__file__).resolve().parent
+    for name in ENGINE_MODULES:
+        shutil.copy2(here/name, engine/name)
+    (engine/"__init__.py").write_text('"""Pinned LTP inference engine."""\n', encoding="utf-8")
+    shutil.copy2(__file__, package/"worker.py")
+    checkpoint_before = _sha(checkpoint)
+    shutil.copy2(checkpoint, package/"model.pt")
+    if checkpoint_before != _sha(checkpoint) or checkpoint_before != _sha(package/"model.pt"):
+        raise RuntimeError("Checkpoint changed while making the remote snapshot.")
+    original_hashes = {}
+    if remote_source:
+        worker_source = source_path
+    else:
+        source_file = Path(source_path).resolve()
+        inputs = package/"input"; inputs.mkdir()
+        for path in _image_files(source_file):
+            rel = path.relative_to(source_file.parent)
+            target = inputs/rel; target.parent.mkdir(parents=True, exist_ok=True)
+            before = _sha(path); shutil.copy2(path, target)
+            if before != _sha(path) or before != _sha(target):
+                raise RuntimeError("Image changed while making the remote snapshot.")
+            original_hashes[str(path)] = before
+        worker_source = "input/" + source_file.name
+    pins = {p.relative_to(package).as_posix(): _sha(p) for p in sorted(package.rglob("*")) if p.is_file()}
+    manifest = {"protocol": PROTOCOL, "job_id": job_id, "created_unix": time.time(),
+                "files_sha256": pins, "checkpoint_sha256": checkpoint_before,
+                "source": {"path": worker_source, "series": series, "remote_existing": remote_source,
+                           "original": str(source), "local_source_sha256": original_hashes},
+                "options": options, "require_gpu": True, "cpu_fallback": False, "requested_device": requested_device,
+                "workstation": {"target": ws.target, "os": ws.os}}
+    _write(package/"manifest.json", manifest)
+    return package, manifest
+
+
+def _verify_package(root, job_id, manifest_sha, *, verify_inputs=True):
+    if not len(job_id) == 32 or any(c not in "0123456789abcdef" for c in job_id):
+        raise ValueError("Invalid inference job identity.")
+    if _sha(root/"manifest.json") != manifest_sha:
+        raise RuntimeError("Remote inference manifest differs from the submitted job.")
+    manifest = json.loads((root/"manifest.json").read_text(encoding="utf-8"))
+    if manifest.get("protocol") != PROTOCOL or manifest.get("job_id") != job_id or manifest.get("require_gpu") is not True:
+        raise RuntimeError("Remote inference job contract differs.")
+    pins = manifest.get("files_sha256")
+    if not isinstance(pins, dict) or not {"worker.py", "model.pt", "label_workflow_engine/inference.py"} <= set(pins):
+        raise RuntimeError("Incomplete remote inference package.")
+    for name, digest in pins.items():
+        if not verify_inputs and name != "worker.py":
+            continue
+        path = root/str(_checked_relative(name))
+        if not path.is_file() or path.is_symlink() or _sha(path) != digest:
+            raise RuntimeError("Remote input/source differs: " + name)
+    return manifest
+
+
+class _CancelFile:
+    def __init__(self, path): self.path = path
+    def is_set(self): return self.path.exists()
+
+
+def _select_remote_gpu(requested="auto"):
+    """Probe this process's workstation, never the originating computer."""
+    import torch
+    requested = _device_request(requested)
+    devices = []
+    if requested != "mps" and torch.cuda.is_available():
+        for index in range(torch.cuda.device_count()):
+            free, total = torch.cuda.mem_get_info(index)
+            devices.append({"index": index, "name": torch.cuda.get_device_name(index),
+                            "free_bytes": int(free), "total_bytes": int(total)})
+        if requested.startswith("cuda:"):
+            index = int(requested.split(":")[1])
+            if index >= len(devices): raise RuntimeError("The requested workstation CUDA device does not exist.")
+            chosen = devices[index]
+        else:
+            chosen = max(devices, key=lambda item: (item["free_bytes"], -item["index"]))
+        torch.cuda.set_device(chosen["index"])
+        return "cuda:" + str(chosen["index"]), {"method": "explicit_cuda_index" if requested.startswith("cuda:") else "largest_current_free_cuda_memory", "devices": devices,
+                                                "requested_device": requested,
+                                                "selected": chosen, "probed_on": "remote_worker"}
+    mps = getattr(torch.backends, "mps", None)
+    if requested in ("auto", "mps") and mps is not None and mps.is_available():
+        return "mps", {"method": "available_apple_gpu", "requested_device": requested, "probed_on": "remote_worker", "cuda_devices": []}
+    raise RuntimeError("The workstation has no supported GPU. Remote neural inference never falls back to CPU.")
+
+
+def worker(root, job_id, manifest_sha, action="run"):
+    """Run only in the selected workstation interpreter; cancel is framework-free."""
+    root = Path(root).resolve()
+    manifest = _verify_package(root, job_id, manifest_sha, verify_inputs=action != "cancel")
+    if action == "cancel":
+        _write(root/"CANCEL.json", {"job_id": job_id, "manifest_sha256": manifest_sha})
+        return
+    # Exclusive creation prevents duplicate execution, including after interruption.
+    with (root/"STARTED.json").open("x", encoding="utf-8") as stream:
+        json.dump({"job_id": job_id, "pid": os.getpid(), "started_unix": time.time()}, stream)
+    cancel = _CancelFile(root/"CANCEL.json")
+    try:
+        if cancel.is_set(): raise RuntimeError("Remote inference cancelled before model loading.")
+        import sys
+        sys.path.insert(0, str(root))
+        from label_workflow_engine.inference import run_full_image
+        device, selection = _select_remote_gpu(manifest["requested_device"])
+        source = manifest["source"]
+        path = Path(source["path"]) if source["remote_existing"] else root/str(_checked_relative(source["path"]))
+        before = {str(p): _sha(p) for p in _image_files(path)}
+        selected_source = str(path) + ("::" + source["series"] if source["series"] else "")
+        def progress(event):
+            print("LWPROGRESS " + json.dumps(event), flush=True)
+        report = run_full_image(root/"model.pt", selected_source, root/"results", cache_dir=root/"cache",
+                                progress=progress, cancel=cancel, device_override=device, require_gpu=True,
+                                **manifest["options"])
+        if cancel.is_set(): raise RuntimeError("Remote inference cancelled; outputs remain unreviewed and incomplete.")
+        after = {str(p): _sha(p) for p in _image_files(path)}
+        if before != after: raise RuntimeError("Remote image changed during inference.")
+        _verify_package(root, job_id, manifest_sha)
+        folder = Path(report["folder"])
+        report["remote_execution"] = {"protocol": PROTOCOL, "job_id": job_id, "manifest_sha256": manifest_sha,
+                                      "workstation": manifest["workstation"], "gpu_selection": selection,
+                                      "source_sha256_before": before, "source_sha256_after": after,
+                                      "engine_and_inputs_unchanged": True, "cpu_neural_fallback": False,
+                                      "checkpoint_sha256": manifest["checkpoint_sha256"],
+                                      "source_is_remote": bool(source["remote_existing"]),
+                                      "requested_source": source["original"], "remote_folder": str(folder)}
+        _write(folder/"report.json", report)
+        outputs = {p.relative_to(root).as_posix(): _sha(p) for p in sorted(folder.iterdir()) if p.is_file()}
+        completion = {"state": "completed", "job_id": job_id, "manifest_sha256": manifest_sha,
+                      "report_file": (folder/"report.json").relative_to(root).as_posix(), "files_sha256": outputs,
+                      "source_and_inputs_unchanged": True, "reviewed": False}
+        _write(root/"completion.json", completion)
+        print("LWDONE " + job_id, flush=True)
+    except BaseException as exc:
+        _write(root/"failure.json", {"state": "cancelled" if cancel.is_set() else "failed", "job_id": job_id,
+                                   "message": str(exc), "exception": type(exc).__name__})
+        raise
+
+
+def _python(ws):
+    from .remote_ssh import _q
+    if ws.folder_path().startswith("~"):
+        raise ValueError("Use an absolute workstation working-folder path instead of '~' (for example /home/you/labelworkflow).")
+    executable = ws.python or ("python" if ws.windows else "python3")
+    if any(c in executable + ws.folder_path() for c in ("\n", "\r", "\x00")):
+        raise ValueError("Invalid workstation Python path.")
+    if ws.windows and any(c in executable + ws.folder_path() for c in '%!&|<>^"'):
+        raise ValueError("Workstation Windows paths contain unsupported command-shell characters.")
+    if not ws.windows and executable.startswith("~/"):
+        return '"$HOME"/' + _q(ws, executable[2:])
+    return _q(ws, executable)
+
+
+def _command(ws, remote_job, job_id, digest, action="run"):
+    from .remote_ssh import _q
+    return f"{_python(ws)} -u {_q(ws, remote_job + '/worker.py')} --action {action} --job-id {job_id} --manifest-sha256 {digest}"
+
+
+def _validate_completion(completion, manifest, manifest_sha):
+    if completion.get("state") != "completed" or completion.get("job_id") != manifest["job_id"] or completion.get("manifest_sha256") != manifest_sha or completion.get("source_and_inputs_unchanged") is not True or completion.get("reviewed") is not False:
+        raise RuntimeError("Remote inference completion does not match this unreviewed job.")
+    pins = completion.get("files_sha256")
+    if not isinstance(pins, dict) or not pins or completion.get("report_file") not in pins:
+        raise RuntimeError("Remote completion is missing output hashes.")
+    report_path = _checked_relative(completion["report_file"])
+    if report_path.parts[0] != "results" or len(report_path.parts) != 3 or report_path.name != "report.json":
+        raise RuntimeError("Unexpected remote result folder.")
+    for name in pins:
+        path = _checked_relative(name)
+        if path.parent != report_path.parent:
+            raise RuntimeError("Remote output is outside its unique result folder.")
+    return report_path
+
+
+def _validate_report(report, completion, manifest, digest):
+    execution = report.get("remote_execution", {})
+    capacity = report.get("inference_capacity") or {}
+    device = str(report.get("inference_device", ""))
+    if (report.get("status") != "unreviewed_model_prediction" or report.get("reviewed") is not False
+            or execution.get("job_id") != manifest["job_id"] or execution.get("manifest_sha256") != digest
+            or execution.get("engine_and_inputs_unchanged") is not True or execution.get("cpu_neural_fallback") is not False
+            or report.get("checkpoint_sha256") != manifest["checkpoint_sha256"]
+            or execution.get("checkpoint_sha256") != manifest["checkpoint_sha256"]
+            or device.split(":")[0] not in ("cuda", "mps") or capacity.get("device") != device
+            or capacity.get("cpu_neural_fallback") is not False or report.get("gpu_required_for_execution") is not True):
+        raise RuntimeError("Downloaded prediction GPU/checkpoint provenance is invalid.")
+    names = {PurePosixPath(name).name for name in completion["files_sha256"]}
+    declared = report.get("files")
+    if not isinstance(declared, list) or not declared or not set(declared) <= names or not {"report.json", "volumes.csv"} <= names:
+        raise RuntimeError("Downloaded prediction is missing declared outputs.")
+    if not ({"objects.tif", "objects.csv"} <= names or "labels.tif" in names):
+        raise RuntimeError("Downloaded prediction has no segmentation output.")
+    if manifest["options"].get("save_probability") and "probability.tif" not in names:
+        raise RuntimeError("Downloaded prediction is missing its requested probability map.")
+
+
+def run_full_image_remote(ws, checkpoint, source, output_root, *, axes=None, tta=False, save_probability=True,
+                          decoder_overrides=None, channel_map=None, normalization_override=None,
+                          progress=None, cancel=None, source_is_remote=False):
+    """SSH full-image inference; returns a report with its verified LOCAL output folder."""
+    from .remote_ssh import _q, _remote, _run, ssh_args, scp_args
