+"""Execution-local inference batching, independent of checkpoint training hardware.
+
+CUDA tunes only batch size: tile geometry, precision, weights and blending order
+stay fixed. A short forward probe measures this model on the actual execution GPU.
+No model is moved to CPU, no training occurs and no predictions are saved here.
+MPS retains the Mac batch default; it is not given a guessed CUDA-memory budget.
+"""
+from dataclasses import dataclass, field
+import math
+import os
+import time
+
+
+VERSION = "execution-local-capacity-v1"
+
+
+def canonical_device_name(name, cuda_index=0):
+    """Normalize implicit GPU indices without importing/initializing a framework."""
+    kind, separator, index = str(name).partition(":")
+    if kind in ("cuda", "mps"):
+        return f"{kind}:{index if separator else (cuda_index if kind == 'cuda' else 0)}"
+    return str(name)
+
+
+def host_capacity():
+    result = {"logical_cpu_count": os.cpu_count(), "available_ram_bytes": None, "total_ram_bytes": None}
+    try:
+        import psutil
+        memory = psutil.virtual_memory()
+        result.update(available_ram_bytes=int(memory.available), total_ram_bytes=int(memory.total))
+    except ImportError:
+        pass
+    return result
+
+
+def _positive_cap(value):
+    try:
+        number = int(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError("Inference batch cap must be an integer from 1 to 128.") from exc
+    if isinstance(value, bool) or str(number) != str(value) or not 1 <= number <= 128:
+        raise ValueError("Inference batch cap must be an integer from 1 to 128.")
+    return number
+
+
+def batch_settings(mode, device_type, max_batch_size=None, autotune=True, environ=None):
+    """Pure policy parsing, usable without importing a tensor framework."""
+    env = os.environ if environ is None else environ
+    if mode not in ("2.5d", "3d") or device_type not in ("cuda", "mps", "cpu"):
+        raise ValueError("Unsupported inference mode/device.")
+    legacy = env.get("LABEL_WORKFLOW_PREDICT_BATCH", "0")
+    if max_batch_size is not None:
+        cap, source = _positive_cap(max_batch_size), "explicit_argument"
+    elif legacy not in (None, "", "0"):
+        cap, source, autotune = _positive_cap(legacy), "legacy_fixed_batch_environment", False
+    elif env.get("LABEL_WORKFLOW_PREDICT_MAX_BATCH"):
+        cap, source = _positive_cap(env["LABEL_WORKFLOW_PREDICT_MAX_BATCH"]), "maximum_batch_environment"
+    else:
+        cap = (32 if mode == "2.5d" else 8) if device_type == "cuda" else (8 if mode == "2.5d" and device_type == "mps" else 1)
+        source = "device_local_default"
+    if device_type == "cpu":
+        cap = 1
+    return {"max_batch_size": cap, "autotune": bool(autotune and device_type == "cuda" and cap > 1), "cap_source": source}
+
+
+def candidate_batches(cap):
+    values = [1]
+    while values[-1] * 2 <= cap:
+        values.append(values[-1] * 2)
+    if values[-1] != cap:
+        values.append(cap)
+    return values
+
+
+def choose_batch(trials):
+    """Prefer the smaller batch unless measured throughput improves by >5%."""
+    chosen, rate = 1, 0.
+    for trial in trials:
+        if trial.get("state") != "measured":
+            continue
+        current = trial["batch_size"] / trial["seconds"]
+        if current > rate * 1.05:
+            chosen, rate = trial["batch_size"], current
+    return chosen
+
+
+@dataclass
+class InferenceCapacity:
+    device: object
+    mode: str
+    max_batch_size: int
+    autotune: bool
+    cap_source: str
+    initial_memory: dict
+    input_shape: tuple
+    host: dict = field(default_factory=dict)
+    tuning_budget_seconds: float = 3.
+    decisions: list = field(default_factory=list)
+    _cache: dict = field(default_factory=dict, repr=False)
+    forward_seconds: float = 0.
+    forward_calls: int = 0
+    processed_tiles: int = 0
+    peak_allocated_bytes: int = 0
+
+    def _memory(self):
+        import torch
+        if self.device.type != "cuda":
+            return {"free_bytes": None, "total_bytes": None, "available_allocator_bytes": None}
+        free, total = torch.cuda.mem_get_info(self.device)
+        allocated = torch.cuda.memory_allocated(self.device)
+        reserved = torch.cuda.memory_reserved(self.device)
+        peak = torch.cuda.max_memory_allocated(self.device)
+        self.peak_allocated_bytes = max(self.peak_allocated_bytes, int(peak))
+        return {"free_bytes": int(free), "total_bytes": int(total), "allocated_bytes": int(allocated),
+                "reserved_bytes": int(reserved), "available_allocator_bytes": int(free + max(0, reserved-allocated)),
+                "reserve_bytes": int(max(512 * 1024**2, total * .1)), "process_peak_allocated_bytes": int(peak)}
+
+    def _sync(self):
+        import torch
+        if self.device.type == "cuda":
+            torch.cuda.synchronize(self.device)
+        elif self.device.type == "mps":
+            torch.mps.synchronize()
+
+    def _clear_after_oom(self):
+        import torch
+        if self.device.type == "cuda":
+            with torch.cuda.device(self.device):
+                torch.cuda.empty_cache()
+        elif self.device.type == "mps":
+            torch.mps.empty_cache()
+
+    def _forward(self, model, make_batch, count):
+        import torch
+        with torch.inference_mode():
+            value = make_batch(count)
+            if value.device != self.device or value.dtype != torch.float32 or value.shape[0] != count:
+                raise RuntimeError("Inference batch must be FP32 on the selected execution device.")
+            result = model(value)
+            # Do not synchronize/reduce every numerical output here; downstream prediction
+            # retains its finite/shape contracts. Synchronization below bounds the timing.
+            self._sync()
+            return result
+
+    def _tune(self, model, make_batch, pending, key, check_cancel):
+        cap = min(self.max_batch_size, pending)
+        host = host_capacity()
+        # Host staging can hold a list, a stack and its transfer simultaneously.
+        # Leave >=80% of currently available host RAM for extraction/accumulators/IO.
+        bytes_per_tile = math.prod(key[1]) * 4 * 3
+        if host["available_ram_bytes"] is not None:
+            host_cap = int(host["available_ram_bytes"] * .2) // max(1, bytes_per_tile)
+            if host_cap < 1:
+                raise MemoryError("One inference tile exceeds the host staging allowance; use a smaller block/tile.")
+            cap = min(cap, host_cap)
+        record = {"tile_shape": list(key[1]), "available_tiles": pending, "trials": [],
+                  "memory_before": self._memory(), "precision": "unchanged_fp32_no_autocast",
+                  "host_before": host, "host_staging_bytes_per_tile_estimate": bytes_per_tile,
+                  "effective_probe_cap": cap,
+                  "warmup_forwards_per_candidate": 1, "timed_forwards_per_candidate": 1}
+        started = time.perf_counter()
+        if not self.autotune or cap == 1:
+            record.update(selected_batch=cap, reason="fixed_cap_or_single_tile", tuning_seconds=0.)
+        else:
+            per_item = None
+            for n in candidate_batches(cap):
+                check_cancel()
+                if record["trials"] and time.perf_counter()-started >= self.tuning_budget_seconds:
+                    record["stop_reason"] = "probe_time_budget"
+                    break
+                memory = self._memory()
+                usable = max(0, memory["available_allocator_bytes"]-memory["reserve_bytes"])
+                if n > 1 and per_item is not None and per_item*n > usable:
+                    record["stop_reason"] = "free_memory_headroom"
+                    break
+                failed = None
+                try:
+                    warm = self._forward(model, make_batch, n)
+                    del warm
+                    self._sync()
+                    then = time.perf_counter()
+                    output = self._forward(model, make_batch, n)
+                    elapsed = time.perf_counter()-then
+                    del output
+                    after = self._memory()
+                    # CUDA high-water is deliberately never reset (caller provenance keeps
+                    # its full-run peak). The resulting per-item estimate is conservative.
+                    cost = max(1, after["process_peak_allocated_bytes"]-memory["allocated_bytes"])
+                    per_item = max(per_item or 0, cost/n)
+                    record["trials"].append({"state": "measured", "batch_size": n,
+                                             "seconds": max(elapsed, 1e-9), "memory_after": after})
+                except RuntimeError as exc:
+                    if "out of memory" not in str(exc).lower():
+                        raise
+                    failed = str(exc)
+                    exc.__traceback__ = None
+                if failed is not None:
+                    self._clear_after_oom()
+                    record["trials"].append({"state": "cuda_oom", "batch_size": n, "message": failed})
+                    record["stop_reason"] = "probe_oom"
+                    if n == 1:
+                        self.decisions.append(record)
+                        raise RuntimeError("GPU inference cannot fit one tile. Use a smaller tile/block; no CPU fallback.")
+                    break
+            record.update(selected_batch=choose_batch(record["trials"]), reason="measured_forward_throughput",
+                          tuning_seconds=time.perf_counter()-started)
+        record["runtime_oom_retries"] = []
+        self.decisions.append(record)
+        self._cache[key] = record
+        return record
+
+    def run(self, model, make_batch, pending, tile_shape, check_cancel=lambda: None):
+        """Forward a batch; OOM halves before any tile is blended, never duplicating it."""
+        import torch
+        actual = next(model.parameters()).device
+        if actual != self.device or model.training:
+            raise RuntimeError("Inference policy requires its selected device and an eval-mode model.")
+        from .accel import autocast_enabled
+        if autocast_enabled(actual):
+            raise RuntimeError("Capacity-controlled inference preserves FP32; disable external autocast.")
+        key = (id(model), tuple(tile_shape))
+        record = self._cache.get(key)
+        if record is None or record["available_tiles"] < min(self.max_batch_size, pending):
+            record = self._tune(model, make_batch, pending, key, check_cancel)
+        count = min(int(record["selected_batch"]), pending)
+        while True:
+            check_cancel()
+            failed = None
+            try:
+                self._sync()
+                then = time.perf_counter()
+                output = self._forward(model, make_batch, count)
+                self.forward_seconds += time.perf_counter()-then
+                self.forward_calls += 1
+                self.processed_tiles += count
+                self._memory()
+                return output, count
+            except RuntimeError as exc:
+                if "out of memory" not in str(exc).lower() or self.device.type == "cpu":
+                    raise
+                failed = str(exc)
+                exc.__traceback__ = None
+            self._clear_after_oom()
+            if count == 1:
+                record["runtime_oom_retries"].append({"from_batch": 1, "to_batch": None, "message": failed})
+                raise RuntimeError("GPU inference exhausted memory at batch 1; no CPU fallback.")
+            smaller = max(1, count//2)
+            record["runtime_oom_retries"].append({"from_batch": count, "to_batch": smaller, "message": failed,
+                                                   "memory": self._memory()})
+            count = smaller
+            record["selected_batch"] = smaller
+
+    def to_dict(self):
+        return {"version": VERSION, "device": str(self.device), "mode": self.mode,
+                "input_shape": list(self.input_shape), "max_batch_size": self.max_batch_size,
+                "autotune": self.autotune, "cap_source": self.cap_source,
+                "initial_memory": self.initial_memory, "decisions": self.decisions,
+                "execution_host": self.host,
+                "forward_seconds_including_batch_transfer": self.forward_seconds,
+                "forward_calls": self.forward_calls, "processed_tiles": self.processed_tiles,
+                "process_peak_allocated_bytes": self.peak_allocated_bytes,
+                "tuning_seconds": sum(r.get("tuning_seconds", 0.) for r in self.decisions),
