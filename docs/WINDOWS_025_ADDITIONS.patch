+"""Disposable remote CUDA benchmark; no training/scientific inputs/environment changes.
+
+PYTHONPATH=src python -B tests/benchmark_inference_capacity_cuda.py --output /new/path.json
+Parent must run under the study GPU lock; this also refuses any foreign GPU process.
+One warmup, one tuning run, then three paired batch1/selected-batch timings per mode.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import time
+
+import numpy as np
+import torch
+
+from napari_label_workflow import training as tr
+from napari_label_workflow import inference_capacity as cap
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    output = Path(args.output)
+    if output.exists():
+        raise FileExistsError("Benchmark refuses to overwrite existing evidence.")
+    if sys.platform != "linux" or not torch.cuda.is_available() or torch.cuda.get_device_name() != "NVIDIA RTX 6000 Ada Generation":
+        raise RuntimeError("Remote RTX 6000 Ada CUDA required; no CPU fallback.")
+    rows = subprocess.check_output(["nvidia-smi", "--query-compute-apps=pid", "--format=csv,noheader,nounits"], text=True)
+    if any(int(row.strip()) != os.getpid() for row in rows.splitlines() if row.strip()):
+        raise RuntimeError("Foreign GPU compute exists; benchmark refuses to overlap it.")
+    torch.set_num_threads(4)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    source_files = [Path(tr.__file__), Path(cap.__file__), Path(__file__)]
+    hashes = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_files}
+    receipt = {"state": "running", "kind": "synthetic_inference_capacity_benchmark", "models_trained": 0,
+               "source_hashes": hashes, "torch": torch.__version__, "tf32": False, "threads": 4,
+               "timing_repeats": 3, "warmups_per_mode": 1, "models": []}
+    for mode, shape, instance in (("2.5d", (1, 12, 384, 384), False), ("3d", (1, 16, 320, 320), True)):
+        torch.manual_seed(419)
+        c = tr.TrainingConfig(mode=mode, device="cuda", width=16, depth=4, patch=(16, 128, 128),
+                              instance=instance, context=5, auxiliary_heads=["flow", "embedding", "offset"] if instance else [])
+        model = tr._make_model(c).cuda().eval()
+        image = np.random.default_rng(419).random(shape, dtype=np.float32)
+        fixed = cap.select_inference_capacity(c, shape, "cuda", max_batch_size=1, autotune=False)
+        adaptive = cap.select_inference_capacity(c, shape, "cuda")
+        tr.predict_loaded(model, c, image, inference_policy=fixed, require_gpu=True)
+        torch.cuda.synchronize()
+        started = time.perf_counter()
+        tuned = tr.predict_loaded(model, c, image, inference_policy=adaptive, require_gpu=True)
+        tuning_run_seconds = time.perf_counter()-started
+        times = {"batch1": [], "adaptive_cached": []}
+        peak = {"batch1": [], "adaptive_cached": []}
+        differences = []
+        for _ in range(3):
+            expected = None
+            for label, policy in (("batch1", fixed), ("adaptive_cached", adaptive)):
+                torch.cuda.synchronize()
+                torch.cuda.reset_peak_memory_stats()
+                started = time.perf_counter()
+                result = tr.predict_loaded(model, c, image, inference_policy=policy, require_gpu=True)
+                torch.cuda.synchronize()
+                times[label].append(time.perf_counter()-started)
+                peak[label].append(torch.cuda.max_memory_allocated())
+                if label == "batch1":
+                    expected = result
+                else:
+                    per_output = []
+                    for left, right in zip(expected, result):
+                        if left is not None:
+                            np.testing.assert_allclose(left, right, atol=5e-5, rtol=5e-5)
+                            per_output.append(float(np.max(np.abs(left-right))))
+                    differences.append(per_output)
+        for left, right in zip(expected, tuned):
+            if left is not None:
+                np.testing.assert_allclose(left, right, atol=5e-5, rtol=5e-5)
+        receipt["models"].append({"mode": mode, "instance": instance, "shape": shape,
+                                  "config": tr.asdict(c), "timing_seconds": times,
+                                  "peak_allocated_bytes": peak, "first_adaptive_run_including_tuning_seconds": tuning_run_seconds,
+                                  "cached_median_speed_ratio": statistics.median(times["batch1"])/statistics.median(times["adaptive_cached"]),
+                                  "output_max_abs_differences": differences, "allclose_atol_rtol": [5e-5, 5e-5],
+                                  "fixed_capacity": fixed.to_dict(), "adaptive_capacity": adaptive.to_dict()})
+        del model, tuned, expected, result
+        torch.cuda.empty_cache()
+    if hashes != {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_files}:
+        raise RuntimeError("Source changed during benchmark.")
+    receipt.update(state="passed", source_unchanged=True,
+                   limits="Synthetic random-weight forward/blending timing only; no accuracy/decoder/transport/file-IO measurement. Batch size may remain1 when faster.")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("x", encoding="utf-8") as stream:
+        json.dump(receipt, stream, indent=2)
+    print(json.dumps({"state": receipt["state"], "output": str(output),
+                      "modes": [{"mode": row["mode"], "cached_speed_ratio": row["cached_median_speed_ratio"]} for row in receipt["models"]]}))
+
+
+if __name__ == "__main__":
+    main()
