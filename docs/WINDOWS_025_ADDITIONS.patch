+"""File/transport contracts only: no model construction, GPU or network execution."""
+import ast
+import copy
+import io
+import json
+from pathlib import Path
+import shlex
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from napari_label_workflow import remote_inference as ri
+from napari_label_workflow.remote_ssh import Workstation
+
+
+class RemoteInferenceContracts(unittest.TestCase):
+    def ws(self):
+        return Workstation(host="gpu-workstation", user="labuser", folder="/tmp/ltp-test", python="/venv/bin/python", enabled=True)
+
+    def package(self, root, remote=False):
+        checkpoint = root/"original.pt"; checkpoint.write_bytes(b"checkpoint-storage-only")
+        image = root/"image.tif"; image.write_bytes(b"image-storage-only")
+        return ri.prepare_package(self.ws(), checkpoint, str(image) if not remote else "ssh://labuser@gpu-workstation/data/image.tif::1", root/"outputs")
+
+    def test_snapshot_hashes_and_series_preserve_originals(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp); package, manifest = self.package(root)
+            self.assertEqual(ri._verify_package(package, manifest["job_id"], ri._sha(package/"manifest.json")), manifest)
+            self.assertEqual((package/"input/image.tif").read_bytes(), (root/"image.tif").read_bytes())
+            self.assertIn("label_workflow_engine/inference_capacity.py", manifest["files_sha256"])
+            self.assertTrue(manifest["require_gpu"])
+            (package/"label_workflow_engine/accel.py").write_bytes(b"changed")
+            with self.assertRaisesRegex(RuntimeError, "differs"):
+                ri._verify_package(package, manifest["job_id"], ri._sha(package/"manifest.json"))
+
+    def test_remote_source_does_not_open_or_copy_the_image_locally(self):
+        with tempfile.TemporaryDirectory() as temp:
+            package, manifest = self.package(Path(temp), remote=True)
+            self.assertEqual(manifest["source"]["path"], "/data/image.tif")
+            self.assertEqual(manifest["source"]["series"], "1")
+            self.assertTrue(manifest["source"]["remote_existing"])
+            self.assertFalse((package/"input").exists())
+        for source in ("ssh://other@gpu-workstation/data/a.tif", "ssh://labuser@other/data/a.tif", "ssh://labuser@gpu-workstation/a?query=1"):
+            with self.assertRaises(ValueError): ri._source_parts(source, self.ws(), True)
+        with self.assertRaises(ValueError): ri._source_parts("relative.tif", self.ws(), True)
+
+    def test_explicit_cpu_refused_before_snapshot_or_transport(self):
+        ws = self.ws(); ws.device = "cpu"
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            with self.assertRaisesRegex(ValueError, "not CPU"):
+                ri.prepare_package(ws, "not-read.pt", "not-read.tif", root/"outputs")
+            self.assertFalse((root/"outputs").exists())
+
+    def test_tilde_workfolder_rejected_before_transport(self):
+        ws = self.ws(); ws.folder = "~/labelworkflow"
+        with patch.object(Workstation, "validate", new=lambda self: None):
+            with self.assertRaisesRegex(ValueError, "absolute workstation"):
+                ri.run_full_image_remote(ws, "not-read.pt", "not-read.tif", "not-created")
+
+    def test_cancel_is_identity_checked_and_framework_free(self):
+        with tempfile.TemporaryDirectory() as temp:
+            package, manifest = self.package(Path(temp))
+            digest = ri._sha(package/"manifest.json")
+            with self.assertRaises(RuntimeError): ri.worker(package, "0"*32, digest, "cancel")
+            with self.assertRaises(RuntimeError): ri.worker(package, manifest["job_id"], "0"*64, "cancel")
+            ri.worker(package, manifest["job_id"], digest, "cancel")
+            self.assertTrue((package/"CANCEL.json").exists())
+            self.assertFalse((package/"STARTED.json").exists())
+
+    def test_completion_rejects_wrong_identity_traversal_and_outside_outputs(self):
+        m = {"job_id": "a"*32}; digest = "b"*64
+        good = {"state": "completed", "job_id": m["job_id"], "manifest_sha256": digest,
+                "source_and_inputs_unchanged": True, "reviewed": False, "report_file": "results/one/report.json",
+                "files_sha256": {"results/one/report.json": "c"*64, "results/one/objects.tif": "d"*64}}
+        self.assertEqual(str(ri._validate_completion(good, m, digest)), "results/one/report.json")
+        for key, value in (("job_id", "z"*32), ("state", "failed"), ("reviewed", True), ("source_and_inputs_unchanged", False), ("manifest_sha256", "x"*64)):
+            broken = dict(good); broken[key] = value
+            with self.assertRaises(RuntimeError): ri._validate_completion(broken, m, digest)
+        for name in ("../stolen", "/absolute", "results/other/x", "results\\one\\x", "C:/outside", "C:outside", "results/one/report.json:stream"):
+            broken = copy.deepcopy(good); broken["files_sha256"][name] = "e"*64
+            with self.assertRaises((ValueError, RuntimeError)): ri._validate_completion(broken, m, digest)
+        with self.assertRaises(ValueError): ri._checked_relative(None)
+
+    def test_worker_selects_remote_capacity_and_forces_gpu_in_both_modes(self):
+        tree = ast.parse(Path(ri.__file__).read_text(encoding="utf-8"))
