+    emit = progress or (lambda event: None)
+    if cancel is not None and cancel.is_set(): raise RuntimeError("Remote inference cancelled.")
+    emit({"phase": "Preparing remote inference", "message": "Snapshotting checkpoint and image; no local model execution."})
+    package, manifest = prepare_package(ws, checkpoint, source, output_root, source_is_remote=source_is_remote,
+                                        axes=axes, tta=bool(tta), save_probability=bool(save_probability),
+                                        decoder_overrides=decoder_overrides, channel_map=channel_map,
+                                        normalization_override=normalization_override)
