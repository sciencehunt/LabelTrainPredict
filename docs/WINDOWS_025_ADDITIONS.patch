+        cuda.set_device = lambda i: self.assertEqual(i, 0)
+        with patch.dict("sys.modules", {"torch": fake}):
+            device, receipt = ri._select_remote_gpu("cuda:0")
+            self.assertEqual(device, "cuda:0"); self.assertEqual(receipt["requested_device"], "cuda:0")
+            with self.assertRaises(RuntimeError): ri._select_remote_gpu("cuda:9")
+        with patch.dict("sys.modules", {"torch": SimpleNamespace(cuda=SimpleNamespace(is_available=lambda: False), backends=SimpleNamespace(mps=None))}):
+            with self.assertRaisesRegex(RuntimeError, "never falls back"): ri._select_remote_gpu()
+
+    def test_mock_ssh_upload_progress_download_and_output_hash_validation(self):
+        self._transport(False)
+
+    def test_mock_transport_rejects_tampered_download(self):
+        self._transport(True)
+
+    def test_mock_cancel_only_addresses_its_own_job_and_withholds_outputs(self):
+        self._transport(False, cancel_job=True)
+
+    def _transport(self, corrupt, cancel_job=False):
+        from napari_label_workflow import remote_ssh
+        with tempfile.TemporaryDirectory() as temp:
