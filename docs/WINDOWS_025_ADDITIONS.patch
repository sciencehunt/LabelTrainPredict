+            lines.append(line); lines = lines[-40:]
+            if line.startswith("LWPROGRESS "):
+                try:
+                    info = json.loads(line[len("LWPROGRESS "):]); info["phase"] = f"{info.get('phase', 'Inference')} (on {ws.host})"; emit(info)
+                except (ValueError, TypeError): pass
+            if line == "LWDONE " + job_id: completed = True
+    code = process.wait()
+    if cancel_sent or (cancel is not None and cancel.is_set()):
+        raise RuntimeError("Remote inference cancelled; the remote job snapshot is retained.")
+    if code != 0 or not completed:
+        raise RuntimeError(f"Remote inference failed on {ws.host}; job {remote_job}:\n" + "\n".join(lines[-12:]))
+    emit({"phase": f"Downloading inference outputs from {ws.host}", "message": "Verifying every returned file."})
+    _run(scp_args(ws, [f"{ws.target}:{remote_job}/completion.json"], str(package/"completion.json")), timeout=1800)
+    completion = json.loads((package/"completion.json").read_text(encoding="utf-8"))
+    report_path = _validate_completion(completion, manifest, digest)
+    local = Path(output_root).resolve()/("remote_" + job_id); local.mkdir(exist_ok=False)
+    for name, expected in completion["files_sha256"].items():
+        target = local/PurePosixPath(name).name
+        _run(scp_args(ws, [f"{ws.target}:{remote_job}/{name}"], str(target)), timeout=3600)
+        if _sha(target) != expected: raise RuntimeError("Downloaded output differs from remote receipt: " + name)
+    report = json.loads((local/report_path.name).read_text(encoding="utf-8"))
+    _validate_report(report, completion, manifest, digest)
+    # Preserve the exact remote report and receipt; local path lives only in the returned view/receipt.
+    _write(local/"download_receipt.json", {"job_id": job_id, "manifest_sha256": digest, "completion": completion,
+                                          "remote_job": remote_job, "local_folder": str(local), "verified": True})
+    report["remote_folder"] = report["folder"]; report["folder"] = str(local)
+    return report
