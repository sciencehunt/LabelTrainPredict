+                c = self.config(mode, instance)
+                model = tr._make_model(c).cuda().eval()
+                image = np.random.default_rng(41).random((1, 9, 65, 67), dtype=np.float32)
+                single = select_inference_capacity(c, image.shape, "cuda", max_batch_size=1, autotune=False)
+                batch = select_inference_capacity(c, image.shape, "cuda", max_batch_size=4, autotune=False)
+                with patch.object(tr, "INFERENCE_TILE_XY", 32), patch.object(tr, "INFERENCE_TILE_Z", 8):
+                    expected = tr.predict_loaded(model, c, image, inference_policy=single, require_gpu=True)
+                    actual = tr.predict_loaded(model, c, image, inference_policy=batch, require_gpu=True)
+                for left, right in zip(expected, actual):
+                    if left is not None:
+                        np.testing.assert_allclose(left, right, atol=5e-5, rtol=5e-5)
