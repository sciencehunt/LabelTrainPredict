+        call = next(n for n in ast.walk(worker) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "run_full_image")
+        self.assertTrue(next(k.value.value for k in call.keywords if k.arg == "require_gpu"))
