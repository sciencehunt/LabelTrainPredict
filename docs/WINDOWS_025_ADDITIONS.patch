+            raise RuntimeError("These tests require the remote Linux CUDA GPU; no CPU fallback.")
+        if torch.cuda.get_device_name() != "NVIDIA RTX 6000 Ada Generation":
+            raise RuntimeError("Expected gpu-workstation RTX 6000 Ada.")
+        rows = subprocess.check_output(["nvidia-smi", "--query-compute-apps=pid", "--format=csv,noheader,nounits"], text=True)
+        if any(int(row.strip()) != os.getpid() for row in rows.splitlines() if row.strip()):
+            raise RuntimeError("Foreign GPU process detected; tests refuse to overlap it.")
+        torch.set_num_threads(4)
+        torch.backends.cuda.matmul.allow_tf32 = False
