+    code = f"from pathlib import Path;p=Path({remote_job!r});p.parent.mkdir(parents=True,exist_ok=True);p.mkdir(exist_ok=False)"
+    encoded = base64.b64encode(code.encode()).decode()
+    bootstrap = "import base64;exec(base64.b64decode('" + encoded + "'))"
+    _run(ssh_args(ws, _python(ws) + " -c " + _q(ws, bootstrap)), timeout=90)
+    emit({"phase": f"Uploading inference package to {ws.host}", "message": package.name})
+    _run(scp_args(ws, [str(package)], f"{ws.target}:{ws.folder_path()}/"), timeout=3600)
+    if cancel is not None and cancel.is_set(): raise RuntimeError("Remote inference cancelled before launch; uploaded snapshot retained.")
+    process = subprocess.Popen(ssh_args(ws, _command(ws, remote_job, job_id, digest)), stdout=subprocess.PIPE,
+                               stderr=subprocess.STDOUT, text=True, bufsize=1)
+    events = queue.Queue(); sentinel = object()
+    def read():
+        try:
+            for line in process.stdout: events.put(line)
+        finally: events.put(sentinel)
+    threading.Thread(target=read, daemon=True).start()
+    lines = []; completed = False; cancel_sent = False
+    with (package/"transport.log").open("w", encoding="utf-8") as log:
+        while True:
+            if cancel is not None and cancel.is_set() and not cancel_sent:
+                # Only this UUID's checked worker can create its own cancellation sentinel.
+                _run(ssh_args(ws, _command(ws, remote_job, job_id, digest, "cancel")), timeout=90)
+                cancel_sent = True
+                emit({"phase": "Cancelling remote inference", "message": "Waiting for this job's current GPU operation to finish."})
+            try: event = events.get(timeout=.25)
+            except queue.Empty: continue
+            if event is sentinel: break
